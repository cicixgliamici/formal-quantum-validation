{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formal-quantum-validation.local/schemas/verification-manifest-0.1.json",
  "title": "Formal Quantum Validation Verification Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "passed",
    "inputs",
    "verification",
    "transpilation_equivalence",
    "certificate",
    "formal_proof",
    "toolchain"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "passed": {"type": "boolean"},
    "inputs": {"type": "object"},
    "verification": {"type": "object"},
    "transpilation_equivalence": {"type": ["object", "null"]},
    "certificate": {"type": ["object", "null"]},
    "formal_proof": {"type": ["object", "null"]},
    "toolchain": {"type": "object"}
  }
}
