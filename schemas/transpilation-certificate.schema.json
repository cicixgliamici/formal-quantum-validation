{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formal-quantum-validation.local/schemas/transpilation-certificate-0.2.json",
  "title": "Formal Quantum Validation Transpilation Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "equivalence", "source", "candidate", "steps"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "equivalence": {"const": "exact"},
    "source": {"$ref": "circuit-ir.schema.json"},
    "candidate": {"$ref": "circuit-ir.schema.json"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "position", "gate", "targets", "controls"],
        "properties": {
          "rule": {"const": "cancel_self_inverse"},
          "position": {"type": "integer", "minimum": 0},
          "gate": {"enum": ["X", "Z", "H", "CNOT", "SWAP"]},
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 0}
          },
          "controls": {
            "type": "array",
            "maxItems": 1,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
